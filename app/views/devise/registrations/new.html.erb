<div class="antialiased">
<div class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-background-dark font-display overflow-x-hidden">


<div class="flex items-center p-4 pb-2 justify-between sticky top-0 z-10 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-sm">
<button class="text-slate-900 dark:text-white flex size-12 shrink-0 items-center justify-center rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-colors">
<i class="fa-solid fa-arrow-left"></i>
</button>
<h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em] flex-1 text-center pr-12">Criar Conta</h2>
</div>


<div class="flex-1 flex flex-col px-4 pt-2 pb-8 max-w-md mx-auto w-full">


<div class="flex flex-col items-center">
<h1 class="text-slate-900 dark:text-white tracking-tight text-[32px] font-bold leading-tight text-center pt-4">Participar da Central de Talentos</h1>
<p class="text-slate-500 dark:text-gray-400 text-base font-normal leading-normal pb-6 pt-2 text-center">Conecte-se com o Capão Comprido em segundos</p>
</div>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>


<div class="flex flex-col gap-5">


<label class="flex flex-col w-full">
  <p class="text-slate-900 dark:text-white text-sm font-medium leading-normal pb-2 ml-1">Nome</p>
  <div class="flex w-full items-stretch rounded-full bg-white dark:bg-input-dark border border-gray-200 dark:border-input-border-dark focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all overflow-hidden h-14">
    <%= f.text_field :name,
      class: "flex w-full min-w-0 flex-1 bg-transparent text-slate-900 dark:text-white focus:outline-0 border-none h-full placeholder:text-placeholder-light px-5 text-base",
      placeholder: "João" %>
    <div class="text-gray-400 flex items-center pr-5 pl-2">
      <i class="fa-solid fa-user"></i>
    </div>
  </div>
</label>

<label class="flex flex-col w-full">
  <p class="text-slate-900 dark:text-white text-sm font-medium leading-normal pb-2 ml-1">Sobrenome</p>
  <div class="flex w-full items-stretch rounded-full bg-white dark:bg-input-dark border border-gray-200 dark:border-input-border-dark focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
    <%= f.text_field :last_name,
      class: "flex w-full flex-1 bg-transparent border-none px-5 placeholder:text-placeholder-light text-slate-900 dark:text-white",
      placeholder: "da Silva" %>
    <div class="text-gray-400 flex items-center pr-5 pl-2">
      <i class="fa-solid fa-user"></i>
    </div>
  </div>
</label>

<label class="flex flex-col w-full">
  <p class="text-slate-900 dark:text-white text-sm font-medium leading-normal pb-2 ml-1">Email</p>
  <div class="flex w-full items-stretch rounded-full bg-white dark:bg-input-dark border border-gray-200 dark:border-input-border-dark focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
    <%= f.email_field :email,
      class: "flex w-full flex-1 bg-transparent placeholder:text-placeholder-light text-slate-900 dark:text-white border-none px-5",
      placeholder: "nome@examplo.com" %>
    <div class="text-gray-400 flex items-center pr-5 pl-2">
      <i class="fa-solid fa-envelope"></i>
    </div>
  </div>
</label>

<%= f.fields_for :provider do |pf| %>
  <label class="flex flex-col w-full">
    <p class="text-slate-900 dark:text-white text-sm font-medium leading-normal pb-2 ml-1">Telefone</p>
    <div class="flex w-full items-stretch rounded-full bg-white dark:bg-input-dark border border-gray-200 dark:border-input-border-dark focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
      <%= pf.telephone_field :phone,
        class: "flex w-full flex-1 bg-transparent placeholder:text-placeholder-light text-slate-900 dark:text-white border-none px-5",
        placeholder: "(61) 99999-9999" %>
      <div class="text-gray-400 flex items-center pr-5 pl-2">
        <i class="fa-solid fa-phone"></i>
      </div>
    </div>
  </label>

  <label class="flex flex-col w-full">
    <p class="text-slate-900 dark:text-white text-sm font-medium leading-normal pb-2 ml-1">Endereço</p>
    <div class="flex w-full items-stretch rounded-full bg-white dark:bg-input-dark border border-gray-200 dark:border-input-border-dark focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
      <%= pf.text_field :address,
        class: "flex w-full flex-1 bg-transparent placeholder:text-placeholder-light text-slate-900 dark:text-white border-none px-5",
        placeholder: "Rua, número" %>
      <div class="text-gray-400 flex items-center pr-5 pl-2">
        <i class="fa-solid fa-location-dot"></i>
      </div>
    </div>
  </label>
<% end %>

<label class="flex flex-col w-full">
  <p class="text-slate-900 dark:text-white text-sm font-medium pb-2 ml-1">Senha (mínimo 6 caracteres)</p>
  <div class="flex w-full rounded-full bg-white dark:bg-input-dark border border-gray-200 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
    <%= f.password_field :password,
      class: "flex w-full flex-1 bg-transparent placeholder:text-placeholder-light text-slate-900 dark:text-white border-none px-5",
      placeholder: "••••••••" %>
    <div class="text-gray-400 flex items-center pr-5 pl-2">
      <i class="fa-solid fa-eye-slash"></i>
    </div>
  </div>
</label>

<label class="flex flex-col w-full">
  <p class="text-slate-900 dark:text-white text-sm font-medium pb-2 ml-1">Confirmar Senha</p>
  <div class="flex w-full rounded-full bg-white dark:bg-input-dark border border-gray-200 focus-within:border-primary focus-within:ring-1 focus-within:ring-primary transition-all h-14">
    <%= f.password_field :password_confirmation,
      class: "flex w-full flex-1 bg-transparent placeholder:text-placeholder-light text-slate-900 dark:text-white border-none px-5",
      placeholder: "••••••••" %>
    <div class="text-gray-400 flex items-center pr-5 pl-2">
      <i class="fa-solid fa-lock"></i>
    </div>
  </div>
</label>
</div>


<div class="pt-8">
  <%= f.submit "Criar Conta",
    class: "flex w-full items-center justify-center rounded-full bg-primary h-14 px-4 text-background-dark font-bold" %>
</div>
<% end %>


<div class="relative flex py-8 items-center">
<div class="flex-grow border-t border-gray-300 dark:border-gray-700"></div>
<div class="flex-grow border-t border-gray-300 dark:border-gray-700"></div>
</div>


<div class="pt-8 pb-4 text-center">
<p class="text-slate-500 dark:text-gray-400 text-sm">
                    Já possui uma conta? 
<a class="text-primary font-semibold hover:text-green-400 transition-colors" href="#">Entrar</a>
</p>
</div>
</div>
</div>
</div>
